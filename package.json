{
  "name": "omnitool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Omnitool: a local-only, no-account toolkit of browser tools for digital creatives and developers.",
  "license": "MIT",
  "repository": "https://github.com/Akash-Das26/Omnitool",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @omnitool/web dev",
    "build": "pnpm --filter @omnitool/web build",
    "preview": "pnpm --filter @omnitool/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "e2e": "playwright test",
    "check:budgets": "node scripts/check-build-budget.mjs",
    "lighthouse": "lhci autorun",
    "features:progress": "node scripts/features-progress.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
